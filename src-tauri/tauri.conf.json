{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peak Launcher",
  "version": "0.1.2",
  "identifier": "com.peaklauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Peak Launcher",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "backgroundColor": "#07080d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNUI3MTU2RERFNzhDNzQKUldSMGpPZmRWbkZiOGJpVVhScFZqeXExNjd1b2tnamRYaUYyTFB2Rm5YK0VaUFluZW8zTFJaWWUK",
      "endpoints": [
        "https://github.com/Ve6om/peak-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
